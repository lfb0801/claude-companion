{
  "description": "Claude Code companion: every event goes to the companion server (SessionStart through curl, as it takes command hooks only); PermissionRequest waits for an answer from the companion or the terminal, whichever comes first.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "curl -s -m 2 -o /dev/null -X POST -H 'content-type: application/json' --data-binary @- http://127.0.0.1:5173/ingest || true", "timeout": 5}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "http", "url": "http://127.0.0.1:5173/ingest", "timeout": 5}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "http", "url": "http://127.0.0.1:5173/ingest", "timeout": 5}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "http", "url": "http://127.0.0.1:5173/ingest", "timeout": 5}]}],
    "PermissionRequest": [{"matcher": "*", "hooks": [{"type": "http", "url": "http://127.0.0.1:5173/ingest", "timeout": 86400}]}],
    "Notification": [{"hooks": [{"type": "http", "url": "http://127.0.0.1:5173/ingest", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "http", "url": "http://127.0.0.1:5173/ingest", "timeout": 5}]}],
    "SessionEnd": [{"hooks": [{"type": "http", "url": "http://127.0.0.1:5173/ingest", "timeout": 5}]}]
  },
  "modules": ["./ask.ts", "./inbox.ts"]
}
